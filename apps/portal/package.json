{
  "name": "@shelv/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "workspaces": [
    "session-integration/runtime"
  ],
  "scripts": {
    "build:rebuild": "node scripts/build-rebuild.mjs",
    "typecheck:rebuild": "tsc -p tsconfig.frontend.json",
    "test:rebuild": "node --experimental-strip-types --test tests/rebuild-foundation*.test.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:session": "npm --prefix session-integration/runtime test",
    "test:backend": "node --experimental-strip-types --test backend/tests/*.test.ts backend/source/tests/concierge-handler.test.ts backend/source/tests/concierge-runtime.test.ts",
    "test:sql": "python3 backend/tests/preview.sql.py && python3 backend/tests/service-workflows.sql.py && python3 backend/tests/private-walkthroughs.sql.py",
    "typecheck:session": "npm --prefix session-integration/runtime run typecheck",
    "verify:session-package": "node session-integration/runtime/scripts/verify-advisor-package.mjs",
    "check:ui": "node scripts/check-ui-system.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
